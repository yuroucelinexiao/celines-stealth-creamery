            <title>B3.1 Roasted Black Sesame</title>
            <link>http://localhost:1313/celines-stealth-creamery/p/b3-1-toasted-sweet-corn-pudding/</link>
            <pubDate>Sun, 24 May 2026 00:00:00 +0000</pubDate>
